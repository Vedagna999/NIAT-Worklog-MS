# Backend Environment Configuration
# For SQLite (default, self-contained):
DATABASE_URL=sqlite:///./niat_worklog.db

# For PostgreSQL (e.g. Render Managed Postgres or Supabase):
# DATABASE_URL=postgresql+psycopg://username:password@host:port/dbname

# JWT Authentication Secret Key (generate a secure random 32+ char string in production)
JWT_SECRET=your-production-jwt-secret-key-32-chars-minimum

# Allowed CORS origins (comma-separated, e.g. your Vercel frontend URL)
# Example: https://niat-worklog.vercel.app,http://localhost:5173
CORS_ORIGINS=*

# Token expiration in minutes (default 24 hours = 1440)
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Server listening port (Render sets $PORT automatically)
PORT=8000
